# Hugging Face Access Token (Optional for public data, recommended for rate limits)
HF_TOKEN=

# Google Cloud & Colab REST API Configuration
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=path/to/service_account_or_credentials.json

# Colab REST API endpoint
COLAB_DISCOVERY_URL=https://colaboratory.googleapis.com/$discovery/rest?version=v1
COLAB_LOCATION=us-central1
